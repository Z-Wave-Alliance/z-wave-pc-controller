<UserControl x:Class="ZWaveControllerUI.Views.AssociationsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZWaveControllerUI.Views"
             xmlns:viewModels="clr-namespace:ZWaveControllerUI.Models"
             AutomationProperties.AutomationId="ID_ASSOCIATIONS_VIEW">
    <Grid ColumnDefinitions="276,Auto,*" RowDefinitions="*,Auto,*">
        <GridSplitter Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="4" ResizeDirection="Rows"/>
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Stretch" HorizontalAlignment="Center" Width="4" ResizeDirection="Columns"/>
        <views:NodesListView Grid.Column="0" Grid.Row="0" DataContext="{Binding ApplicationModel}"/>
        <views:NodeInfoView Grid.Column="0" Grid.Row="2" DataContext="{Binding ApplicationModel}"/>
        <DockPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="3">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Margin="4" Orientation="Horizontal">
                    <Button Content="Create" Command="{Binding AssociationCreateCommand, Converter={StaticResource CommandReference}}" AutomationProperties.AutomationId="ID_BTN_CREATE"/>
                    <Button Content="Remove" Command="{Binding AssociationRemoveCommand, Converter={StaticResource CommandReference}}" AutomationProperties.AutomationId="ID_BTN_REMOVE"/>
                    <Button Content="Get Groups" Command="{Binding AssociationGetGroupsCommand, Converter={StaticResource CommandReference}}" AutomationProperties.AutomationId="ID_BTN_GET_GROUPS"/>
                    <Button Content="Get Nodes" Command="{Binding AssociationGetCommand, Converter={StaticResource CommandReference}}" AutomationProperties.AutomationId="ID_BTN_GET_NODES"/>
                </StackPanel>
                <StackPanel Margin="4">
                    <CheckBox Content="Assign return routes" IsChecked="{Binding IsAssignReturnRoutes}" AutomationProperties.AutomationId="ID_CHK_ASSIGN_RETURN_ROUTES"/>
                </StackPanel>
            </StackPanel>
            <TreeView Name="AssociationsTree" Margin="4,0,4,4" ItemsSource="{Binding AssociativeApplications}" SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                      AutomationProperties.AutomationId="ID_TVW_ASSOCIATIONS_INFO">
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="{x:Type viewModels:AssociativeApplication}" ItemsSource="{Binding Devices}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RootDevice, StringFormat='{}{0} '}" FontWeight="Bold" AutomationProperties.AutomationId="ID_ROOT_DEVICE"/>
                            <TextBlock FontWeight="Bold" Text="{Binding RootDevice, Converter={StaticResource NodeTypeConverter}}"/>
                        </StackPanel>
                    </TreeDataTemplate>
                    <TreeDataTemplate DataType="{x:Type viewModels:AssociativeDevice}" ItemsSource="{Binding Groups}">
                        <TextBlock Text="{Binding Device, Converter={StaticResource AssociativeDeviceNameConverter}}" AutomationProperties.AutomationId="ID_END_POINT"/>
                    </TreeDataTemplate>
                    <TreeDataTemplate DataType="{x:Type viewModels:AssociativeGroup}">
                        <TreeDataTemplate.ItemsSource>
                            <MultiBinding Converter="{StaticResource AssociativeGroupInfoConverter}">
                                <Binding Path="Nodes"/>
                                <Binding Path="GroupInfo"/>
                                <Binding Path="GroupCommandClasses"/>
                            </MultiBinding>
                        </TreeDataTemplate.ItemsSource>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id, StringFormat='Group {0} '}"/>
                            <TextBlock Text="{Binding GroupName, StringFormat='({0})'}"/>
                        </StackPanel>
                    </TreeDataTemplate>
                    <TreeDataTemplate DataType="{x:Type viewModels:AssociativeFolder}" ItemsSource="{Binding Items}">
                        <TextBlock Text="{Binding Name}" FontStyle="Italic" AutomationProperties.AutomationId="ID_NODE_TYPE"/>
                    </TreeDataTemplate>
                    <TreeDataTemplate DataType="{x:Type viewModels:AssociativeNode}">
                        <TextBlock Text="{Binding Item}"/>
                    </TreeDataTemplate>
                </TreeView.DataTemplates>
            </TreeView>
        </DockPanel>
    </Grid>
</UserControl>
