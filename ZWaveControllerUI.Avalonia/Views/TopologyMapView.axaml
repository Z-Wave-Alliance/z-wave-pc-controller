<UserControl x:Class="ZWaveControllerUI.Views.TopologyMapView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZWaveControllerUI.Converters">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="4">
            <Button Content="Reload" Command="{Binding TopologyMapReloadCommand, Converter={StaticResource CommandReference}}"/>
        </StackPanel>
        <ScrollViewer Margin="4" Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <LayoutTransformControl VerticalAlignment="Top" HorizontalAlignment="Left">
                <LayoutTransformControl.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding #zoomSlider.Value}" ScaleY="{Binding #zoomSlider.Value}"/>
                </LayoutTransformControl.LayoutTransform>
                <Canvas Name="mainCanvas" Background="White"/>
            </LayoutTransformControl>
        </ScrollViewer>
        <WrapPanel Margin="4" Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="2">
                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">Zoom:</TextBlock>
                <Slider Name="zoomSlider" Minimum="0.5" Maximum="1.5" Value="1" Width="120" VerticalAlignment="Center"/>
            </StackPanel>
        </WrapPanel>
        <ListBox Grid.RowSpan="3" Grid.Column="1" Margin="4" Width="330" ItemsSource="{Binding ApplicationModel.GenericDeviceTypeColorItems}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <UniformGrid Columns="2">
                        <TextBlock Text="{Binding GenericDeviceText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Static converters:NamedColors.Properties}"
                                  SelectedItem="{Binding ColorArgb, Converter={StaticResource UInt32ToColorPropertyInfoConverter}, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="14" Height="14" Margin="2" Fill="{Binding Converter={StaticResource ColorPropertyBrushConverter}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </UniformGrid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
