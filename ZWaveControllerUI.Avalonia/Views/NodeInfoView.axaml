<UserControl x:Class="ZWaveControllerUI.Views.NodeInfoView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:converters="clr-namespace:ZWaveControllerUI.Converters">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,4">
            <TextBlock FontWeight="Bold" Text="{Binding SelectedNode.Item, StringFormat='{}{0} '}"/>
            <TextBlock Text="{Binding SelectedNode.Item, Converter={StaticResource NodeTypeConverter}}"/>
        </StackPanel>
        <TreeView Name="NodeInfoTreeView"
                  ItemsSource="{Binding SelectedNode.Item, Converter={StaticResource DeviceInfoToNodeViewModelConverter}}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="{x:Type converters:TreeViewItemModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <mi:MaterialIcon Kind="{Binding IconText, Converter={StaticResource IconKindConverter}}" Foreground="{DynamicResource ButtonBackground}"
                                         Width="16" Height="16" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
