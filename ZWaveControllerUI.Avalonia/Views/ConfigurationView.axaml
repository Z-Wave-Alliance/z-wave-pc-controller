<UserControl x:Class="ZWaveControllerUI.Views.ConfigurationView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZWaveControllerUI.Views"
             xmlns:controls="clr-namespace:ZWaveControllerUI.Controls"
             xmlns:viewModels="clr-namespace:ZWaveControllerUI.Models">
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type viewModels:SignedIntegerConfigurationParamViewModel}">
            <DockPanel>
                <controls:NumericUpDown DockPanel.Dock="Right" Width="130" IntValue="{Binding Value, Mode=TwoWay}" MinValue="{Binding MinValue}" MaxValue="{Binding MaxValue}"/>
                <TextBlock Text="{Binding ValueRange}" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UnsignedIntegerConfigurationParamViewModel}">
            <DockPanel>
                <controls:NumericUpDown DockPanel.Dock="Right" Width="130" IntValue="{Binding Value, Mode=TwoWay}" MinValue="{Binding MinValue}" MaxValue="{Binding MaxValue}"/>
                <TextBlock Text="{Binding ValueRange}" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:EnumeratedConfigurationParamViewModel}">
            <ItemsControl ItemsSource="{Binding RadioButtons}" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding Item.ItemValue}" GroupName="{Binding Item.GroupName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BitFieldConfigurationParamViewModel}">
            <ItemsControl ItemsSource="{Binding CheckBoxes}" HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Item}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.DataTemplates>
    <Grid ColumnDefinitions="276,Auto,*" RowDefinitions="*,Auto,*">
        <GridSplitter Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="4" ResizeDirection="Rows"/>
        <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Stretch" HorizontalAlignment="Center" Width="4" ResizeDirection="Columns"/>
        <views:NodesListView Grid.Column="0" Grid.Row="0" DataContext="{Binding ApplicationModel}"/>
        <views:NodeInfoView Grid.Column="0" Grid.Row="2" DataContext="{Binding ApplicationModel}"/>
        <DockPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="3">
            <StackPanel DockPanel.Dock="Top" Margin="4" Orientation="Horizontal">
                <Button Content="Get List" Command="{Binding RetrieveConfigurationListCommand, Converter={StaticResource CommandReference}}"/>
                <Button Content="Set" Command="{Binding ConfigurationSetCommand, Converter={StaticResource CommandReference}}"/>
            </StackPanel>
            <ListBox Margin="4,0,4,4" ItemsSource="{Binding ConfigurationParameters}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3,0,0" ColumnDefinitions="40,150,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ParameterNumber, Converter={StaticResource ByteArrayToInt32Converter}}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ParameterNumber, Converter={StaticResource ByteArrayToStringConverter}, StringFormat='[{0}]'}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <ContentControl Grid.Row="0" Grid.Column="2" Content="{Binding Item}"/>
                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding Info}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
