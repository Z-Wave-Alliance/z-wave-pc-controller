<!-- Sizes and colors of the WPF build: compact, 12px text, flat edit boxes. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource ViewBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ViewForeground}"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EditBorderBrush}"/>
    </Style>
    <Style Selector="TextBox[IsReadOnly=True] /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource EditDisabledBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EditDisabledBorderBrush}"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EditBorderBrush}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="4,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource ItemBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EditBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="20"/>
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource ItemBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource EditBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Vertical"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ItemHoverBackground}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="RowHeight" Value="22"/>
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="20"/>
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource BarBackground}"/>
        <Setter Property="MinWidth" Value="3"/>
        <Setter Property="MinHeight" Value="3"/>
    </Style>
    <Style Selector="GridSplitter:disabled">
        <Setter Property="Background" Value="{DynamicResource BarDisabledBackground}"/>
    </Style>

    <!-- Two line captions fit 36px buttons as with Segoe UI in the WPF build. -->
    <Style Selector="Button TextBlock">
        <Setter Property="LineHeight" Value="14"/>
    </Style>

    <Style Selector="Label">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource BarBackground}"/>
    </Style>
</Styles>
