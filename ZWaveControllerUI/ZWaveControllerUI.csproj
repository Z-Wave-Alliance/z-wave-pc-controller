<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Images\App.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <Configurations>Debug;Release;Setup_Debug;Setup_Release</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Models\Basic\RepeatListManagerViewModel.cs" />
    <Compile Remove="Converters\NodeGenericTypeConverter.cs" />
    <Compile Remove="Converters\NodeHeaderConverter.cs" />
    <Compile Remove="Converters\NodeIdFormatConverter.cs" />
    <Compile Remove="Views\RepeatListManagerView.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MaterialDesignColors" Version="2.0.4" />
    <PackageReference Include="MaterialDesignThemes" Version="4.3.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Content Include="..\z-wave-tools-core\z-wave-blobs\z-wave-tools-core\ZipTransport\win\ziptrans64.dll" Link="ziptrans64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <Content Include="..\z-wave-tools-core\z-wave-blobs\z-wave-tools-core\ZipTransport\win\ziptrans32.dll" Link="ziptrans32.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <Content Include="..\z-wave-tools-core\z-wave-blobs\z-wave-tools-core\ZipTransport\win\ziptrans32.dll" Link="ziptrans32.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\z-wave-tools-core\z-wave-blobs\z-wave-tools-core\ZipTransport\win\ziptrans64.dll" Link="ziptrans64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\App.ico">
